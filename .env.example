# Ücretsiz: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Spendlens'in ödemeleri denetlediği canlı (ya da yerel) örnek
SPENDLENS_URL=https://spendlens.com.tr

# Test imzalayıcısı için bir cüzdan anahtarı — bu demo gerçek zincire hiç
# çıkmıyor (mock bir ücretli-API kullanıyor), sadece imza formatını üretir.
# ../spendlens'te zaten varsa oradan kopyalanabilir, yoksa:
#   cd ../spendlens && npm run new-wallet
AGENT_PRIVATE_KEY=

# İsteğe bağlı — araştırma görevinin konusu
RESEARCH_TASK=Arc ağındaki USDC nanopayment fiyatlandırma trendlerini araştır ve özet bir rapor hazırla

# ── Kendi hesabınla bağlamak istersen (opsiyonel) ───────────────────────────
# Demo hesabı yerine kendi Spendlens hesabını kullanmak için: panelde SEN
# "New agent" ile bir agent oluştur, Policies sayfasına bu repodaki policy
# YAML'ını yapıştır (agent.mjs -> buildPolicyYaml), sonra "Create key" ile
# aldığın anahtarı ve seçtiğin agent id'sini buraya yaz. İkisi de doluysa
# script demo hesabı yerine otomatik olarak bunları kullanır.
SPENDLENS_AGENT_ID=
SPENDLENS_API_KEY=
